ENV_BASE_URL=http://localhost:8000
SPECFORGE_ENABLE_MODAL_BACKEND=1
SPECFORGE_MODAL_APP_NAME=speculate-forge-workers
SPECFORGE_MODAL_PROMPT_LIMIT=5
SPECFORGE_MODAL_MAX_NEW_TOKENS=24

# Optional model overrides for Task 1 validation.
SPECFORGE_TASK1_TARGET_MODEL=Qwen/Qwen2.5-3B-Instruct
SPECFORGE_TASK1_DRAFT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
